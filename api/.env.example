# =============================================================================
# API CLI Configuration
# =============================================================================
# Copy this file to .env and update values as needed
# Environment variables set in your shell will be used as defaults
# Values in .env will override environment variables

# =============================================================================
# Required Settings
# =============================================================================

# Base URL for the API (no trailing slash)
API_BASE=http://localhost:8000/api/

# Default headers for all requests (pipe-separated)
# Example with multiple headers:
#   DEFAULT_HEADERS="Content-Type: application/json|Accept: application/json"
DEFAULT_HEADERS="Content-Type: application/json"

# =============================================================================
# Authentication (Optional)
# =============================================================================

# Authorization header name (default: Authorization)
# AUTH_HEADER=Authorization

# Bearer token for authentication
# Obtain this by logging in to your API and copying the token
# AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
