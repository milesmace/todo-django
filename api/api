#!/usr/bin/env bash
#
# Generic HTTP API CLI Tool
# A thin wrapper over curl + jq for testing any HTTP API
#
# Usage: api METHOD PATH [PAYLOAD_FILE]
#
# Options:
#   -e | --env <file>     Load env file (default: .env in script directory)
#   -v | --verbose        Pretty verbose output
#   -h | --help           Show usage
#

set -euo pipefail

# =============================================================================
# CONSTANTS
# =============================================================================

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly DEFAULT_ENV_FILE="${SCRIPT_DIR}/.env"

# =============================================================================
# GLOBAL VARIABLES
# =============================================================================

VERBOSE=false
ENV_FILE=""
METHOD=""
PATH_ARG=""
PAYLOAD_FILE=""
DATA_PAYLOAD=""

# =============================================================================
# UTILITY FUNCTIONS
# =============================================================================

# Print error message to stderr
error() {
    echo "Error: $1" >&2
}

# Print message only in verbose mode
verbose_print() {
    if [[ "$VERBOSE" == true ]]; then
        echo "$1"
    fi
}

# Mask sensitive token (show first 4 and last 4 chars)
mask_token() {
    local token="$1"
    local len=${#token}

    if [[ $len -le 8 ]]; then
        echo "****"
    else
        echo "${token:0:4}****${token: -4}"
    fi
}

# Check if string is valid JSON
is_json() {
    echo "$1" | jq -e . >/dev/null 2>&1
}

# Pretty print JSON or return raw if not JSON
pretty_print() {
    local content="$1"
    if is_json "$content"; then
        echo "$content" | jq .
    else
        echo "$content"
    fi
}

# =============================================================================
# HELP
# =============================================================================

show_help() {
    cat << 'EOF'
Generic HTTP API CLI Tool

Usage: api [OPTIONS] METHOD PATH [PAYLOAD_FILE]

Arguments:
  METHOD        HTTP method (GET, POST, PUT, PATCH, DELETE, etc.)
  PATH          API endpoint path (e.g., /users, /api/todos/)
  PAYLOAD_FILE  Optional JSON payload file for POST/PUT/PATCH requests

Options:
  -d, --data <data>   HTTP request data (JSON string)
  -e, --env <file>    Load environment file (default: .env in script directory)
  -v, --verbose       Enable verbose output (show request/response details)
  -h, --help          Show this help message

Environment Variables:
  API_BASE            Base URL for the API (required)
  DEFAULT_HEADERS     Pipe-separated list of default headers
  AUTH_HEADER         Authorization header name (default: Authorization)
  AUTH_TOKEN          Bearer token for authentication (optional)

Examples:
  api GET /users
  api POST /users payloads/user.json
  api -v GET /api/todos/
  api --env .env.prod DELETE /users/123

EOF
}

# =============================================================================
# DEPENDENCY CHECKS
# =============================================================================

check_dependencies() {
    if ! command -v jq &>/dev/null; then
        error "jq is required but not installed."
        echo "Install with: sudo apt-get install jq (Debian/Ubuntu)" >&2
        echo "           or: brew install jq (macOS)" >&2
        exit 1
    fi

    if ! command -v curl &>/dev/null; then
        error "curl is required but not installed."
        exit 1
    fi
}

# =============================================================================
# ENVIRONMENT LOADING
# =============================================================================

load_env_file() {
    local env_file="$1"

    if [[ -f "$env_file" ]]; then
        # Read env file and export variables (skip comments and empty lines)
        while IFS= read -r line || [[ -n "$line" ]]; do
            # Skip empty lines and comments
            [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

            # Remove leading/trailing whitespace
            line="${line#"${line%%[![:space:]]*}"}"
            line="${line%"${line##*[![:space:]]}"}"

            # Skip if not a valid variable assignment
            [[ ! "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && continue

            # Extract variable name and value
            local var_name="${line%%=*}"
            local var_value="${line#*=}"

            # Remove surrounding quotes if present
            var_value="${var_value#\"}"
            var_value="${var_value%\"}"
            var_value="${var_value#\'}"
            var_value="${var_value%\'}"

            # Export the variable
            export "$var_name=$var_value"
        done < "$env_file"
    fi
}

# =============================================================================
# ARGUMENT PARSING
# =============================================================================

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -e|--env)
                if [[ -z "${2:-}" ]]; then
                    error "Option $1 requires an argument"
                    exit 1
                fi
                ENV_FILE="$2"
                shift 2
                ;;
            -d|--data)
                if [[ -z "${2:-}" ]]; then
                    error "Option $1 requires an argument"
                    exit 1
                fi
                DATA_PAYLOAD="$2"
                shift 2
                ;;
            -*)
                error "Unknown option: $1"
                show_help
                exit 1
                ;;
            *)
                # Positional arguments
                if [[ -z "$METHOD" ]]; then
                    METHOD="$1"
                elif [[ -z "$PATH_ARG" ]]; then
                    PATH_ARG="$1"
                elif [[ -z "$PAYLOAD_FILE" ]]; then
                    PAYLOAD_FILE="$1"
                else
                    error "Too many arguments"
                    show_help
                    exit 1
                fi
                shift
                ;;
        esac
    done
}

# =============================================================================
# VALIDATION
# =============================================================================

validate_args() {
    # Check required arguments
    if [[ -z "$METHOD" || -z "$PATH_ARG" ]]; then
        error "Missing required arguments: METHOD and PATH"
        show_help
        exit 1
    fi

    # Normalize method to uppercase
    METHOD="${METHOD^^}"

    # Check API_BASE
    if [[ -z "${API_BASE:-}" ]]; then
        error "API_BASE environment variable is not set"
        echo "Set it in your .env file or export it: export API_BASE=http://localhost:8000" >&2
        exit 1
    fi

    # Check payload file for methods that typically need it
    if [[ -n "$PAYLOAD_FILE" && ! -f "$PAYLOAD_FILE" ]]; then
        error "Payload file not found: $PAYLOAD_FILE"
        exit 1
    fi

    # Check that we don't have both payload file and data flag
    if [[ -n "$PAYLOAD_FILE" && -n "$DATA_PAYLOAD" ]]; then
        error "Cannot specify both PAYLOAD_FILE and --data argument"
        exit 1
    fi
}

# =============================================================================
# REQUEST BUILDING AND EXECUTION
# =============================================================================

build_and_execute_request() {
    local url="${API_BASE}${PATH_ARG}"
    local curl_args=(-sS -X "$METHOD")
    local headers=()

    # Parse DEFAULT_HEADERS (pipe-separated)
    if [[ -n "${DEFAULT_HEADERS:-}" ]]; then
        IFS='|' read -ra header_array <<< "$DEFAULT_HEADERS"
        for header in "${header_array[@]}"; do
            # Trim whitespace
            header="${header#"${header%%[![:space:]]*}"}"
            header="${header%"${header##*[![:space:]]}"}"
            if [[ -n "$header" ]]; then
                headers+=("$header")
                curl_args+=(-H "$header")
            fi
        done
    fi

    # Add auth header if token is set
    local auth_header_name="${AUTH_HEADER:-Authorization}"
    local masked_token=""
    if [[ -n "${AUTH_TOKEN:-}" ]]; then
        headers+=("$auth_header_name: Bearer ${AUTH_TOKEN}")
        curl_args+=(-H "$auth_header_name: Bearer ${AUTH_TOKEN}")
        masked_token=$(mask_token "$AUTH_TOKEN")
    fi

    # Add payload file if specified
    local payload_content=""
    if [[ -n "$PAYLOAD_FILE" ]]; then
        curl_args+=(-d "@${PAYLOAD_FILE}")
        payload_content=$(cat "$PAYLOAD_FILE")
    elif [[ -n "$DATA_PAYLOAD" ]]; then
        curl_args+=(-d "$DATA_PAYLOAD")
        payload_content="$DATA_PAYLOAD"
    fi

    # Print verbose request info
    if [[ "$VERBOSE" == true ]]; then
        echo "──────── REQUEST ────────"
        echo "METHOD: $METHOD"
        echo "URL: $url"
        echo "HEADERS:"
        for header in "${headers[@]}"; do
            # Mask auth token in header display
            if [[ "$header" == *"Bearer"* && -n "$masked_token" ]]; then
                local header_name="${header%%:*}"
                echo "  $header_name: Bearer $masked_token"
            else
                echo "  $header"
            fi
        done

        if [[ -n "$payload_content" ]]; then
            echo ""
            echo "PAYLOAD:"
            pretty_print "$payload_content"
        fi
        echo ""
    fi

    # Create temp file for response body
    local tmp_body
    tmp_body=$(mktemp)
    trap "rm -f '$tmp_body'" EXIT

    # Execute curl and capture status code
    local http_code
    local curl_exit_code=0

    http_code=$(curl "${curl_args[@]}" -o "$tmp_body" -w '%{http_code}' "$url") || curl_exit_code=$?

    local response_body
    response_body=$(cat "$tmp_body")

    # Print verbose response info
    if [[ "$VERBOSE" == true ]]; then
        echo "──────── RESPONSE ────────"
        echo "STATUS: $http_code"
        echo ""
        echo "BODY:"
        pretty_print "$response_body"
    else
        # Non-verbose: just output the body (pretty-printed if JSON)
        pretty_print "$response_body"
    fi

    # Exit with error if HTTP status indicates failure (4xx or 5xx)
    if [[ "$http_code" =~ ^[45] ]]; then
        exit 1
    fi

    # Exit with curl's exit code if it failed
    if [[ $curl_exit_code -ne 0 ]]; then
        exit $curl_exit_code
    fi
}

# =============================================================================
# MAIN
# =============================================================================

main() {
    # Check dependencies first
    check_dependencies

    # Parse command line arguments
    parse_args "$@"

    # Load environment file (env file overrides system env vars)
    # First, determine which env file to use
    if [[ -n "$ENV_FILE" ]]; then
        if [[ ! -f "$ENV_FILE" ]]; then
            error "Environment file not found: $ENV_FILE"
            exit 1
        fi
        load_env_file "$ENV_FILE"
    elif [[ -f "$DEFAULT_ENV_FILE" ]]; then
        load_env_file "$DEFAULT_ENV_FILE"
    fi

    # Validate arguments
    validate_args

    # Build and execute the request
    build_and_execute_request
}

# Run main function with all arguments
main "$@"
