# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
COOKIE_DOMAIN=.todoapp.local
SENTRY_DNS=https://sentry.ingest.url

# Database Settings (Django)
DB_NAME=todoapp
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Database Settings (PostgreSQL Container)
POSTGRES_DB=todoapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Cache Settings (Redis)
REDIS_LOCATION=redis://localhost:6379

# Nginx Settings
DOMAIN=api.todoapp.local
